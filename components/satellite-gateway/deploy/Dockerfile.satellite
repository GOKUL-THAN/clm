FROM golang:1.27.3-alpine AS builder

WORKDIR /app

# git is needed by `go mod tidy` to resolve module sources.
RUN apk --no-cache add git

COPY . .

# The gateway ships as a single module on the host, so the module path is
# rewritten to match the github.com/m2p/clm/internal/... imports used across the
# monorepo. go.sum is regenerated here for the same reason, which is why
# dependencies are not pre-downloaded in a separate layer.
RUN sed -i 's|module github.com/m2p/clm/satellite-gateway|module github.com/m2p/clm|' go.mod && \
    go mod tidy && \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/clm-satellite ./cmd/clm-satellite

# Runtime
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata openssl && \
    addgroup -S clm && adduser -S -G clm -h /var/lib/clm clm && \
    mkdir -p /var/lib/clm/state /etc/clm/certs /etc/ssl/private /var/lib/postgresql/certs && \
    chown -R clm:clm /var/lib/clm /etc/clm/certs /etc/ssl/private /var/lib/postgresql/certs && \
    chmod 0750 /var/lib/clm /var/lib/clm/state /etc/clm/certs /etc/ssl/private /var/lib/postgresql/certs

COPY --from=builder --chown=clm:clm /bin/clm-satellite /usr/local/bin/clm-satellite
COPY --chown=clm:clm configs/satellite.yaml /etc/clm/satellite.yaml

ENV CLM_SATELLITE_CONFIG=/etc/clm/satellite.yaml

EXPOSE 8080 9090

USER clm

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/health >/dev/null || exit 1

ENTRYPOINT ["clm-satellite"]
