# Copy to deploy/.env, fill every required value, and keep deploy/.env out of git.
# Generate independent secrets, for example: openssl rand -hex 32

POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
CLM_JWKS_URL=
CLM_EXTERNAL_JWT_ISSUER=
CLM_EXTERNAL_JWT_AUDIENCE=
# Exactly 32 bytes. Prefer CLM_CLOUD_ACCOUNT_MASTER_KEY=file://... in production.
CLM_CLOUD_ACCOUNT_MASTER_KEY=

# Keycloak master-realm administration and confidential backend client.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=
CLM_SERVER_CLIENT_SECRET=

# Isolated test-profile URLs. Use HTTPS for any production-facing deployment.
PUBLIC_URL=http://localhost
CLM_ADMIN_PORTAL_URL=http://localhost
CLM_GATEWAY_PORTAL_URL=http://localhost

# Per-satellite credential returned once by registration/rotation. Do not reuse
# this value across satellites.
CLM_SATELLITE_TOKEN=
CLM_SATELLITE_ID=
CLM_SATELLITE_NAME=
CLM_SAAS_ENDPOINT=https://clm.example.test
CLM_TLS_SERVER_NAME=clm.example.test

# Control-plane HTTPS and gateway mTLS files (mount as read-only secrets).
CLM_TLS_CERT_PATH=/run/secrets/control-plane.crt
CLM_TLS_KEY_PATH=/run/secrets/control-plane.key
CLM_GATEWAY_CLIENT_CA_PATH=/run/secrets/gateway-ca.crt
CLM_GATEWAY_CERT_DIR=
