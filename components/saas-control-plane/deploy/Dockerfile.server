FROM golang:1.27.3-alpine AS builder

WORKDIR /app

# git is needed by `go mod tidy` to resolve module sources.
RUN apk --no-cache add git

COPY . .

# This component lives in a monorepo but is built as a single module here, so the
# module path is rewritten to match the `github.com/m2p/clm/internal/...` imports
# used across the tree. go.sum is regenerated by `go mod tidy` for the same
# reason, which is why dependencies are not pre-downloaded in a separate layer.
RUN sed -i 's|module github.com/m2p/clm/saas-control-plane|module github.com/m2p/clm|' go.mod && \
    go mod tidy && \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/clm-server ./cmd/clm-server

# Runtime
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata && \
    addgroup -S clm && adduser -S -G clm -h /var/lib/clm clm && \
    mkdir -p /var/lib/clm && chown -R clm:clm /var/lib/clm

COPY --from=builder --chown=clm:clm /bin/clm-server /usr/local/bin/clm-server
COPY --chown=clm:clm configs/server.yaml /etc/clm/server.yaml

ENV CLM_CONFIG=/etc/clm/server.yaml

EXPOSE 8080 9090

USER clm

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/health >/dev/null || exit 1

ENTRYPOINT ["clm-server"]
