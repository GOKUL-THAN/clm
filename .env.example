# CLM Platform - Environment Configuration
# Copy this file to .env.local for local development

# =======================================================
# SERVER PORTS
# =======================================================
SAAS_PORTAL_PORT=3000
GATEWAY_PORTAL_PORT=8080

# =======================================================
# Local preview mode (in-memory API only; not database-backed)
# =======================================================
CLM_DEMO_MODE=true
CLM_MOCK_AUTH=true

# =======================================================
# Database-backed local demo (generated by npm run demo:setup)
# =======================================================
# CLM_DEMO_API=go
# CLM_CONFIG=components/saas-control-plane/configs/server-demo.yaml
# CLM_DEMO_DB_PASSWORD=<generated local-only value>
# CLM_DEMO_JWT_SECRET=<generated local-only value>
# CLM_DEMO_CLOUD_MASTER_KEY=<generated local-only value>
# Optional setup overrides when local tools are not on PATH or PostgreSQL
# requires administrator authentication:
# CLM_DEMO_PG_ADMIN_USER=postgres
# CLM_DEMO_PG_ADMIN_PASSWORD=<local PostgreSQL administrator password>
# PSQL_PATH=C:\Program Files\PostgreSQL\18\bin\psql.exe
# CLM_GO_PATH=C:\Program Files\Go\bin\go.exe

# =======================================================
# DEMO CREDENTIALS (local dev only, never production)
# =======================================================
DEMO_ADMIN_EMAIL=admin@enterprise.internal
DEMO_ADMIN_PASSWORD=Demo@2024!
DEMO_LEGAL_EMAIL=legal-lead@enterprise.internal
DEMO_LEGAL_PASSWORD=Demo@2024!
DEMO_AUDITOR_EMAIL=auditor@enterprise.internal
DEMO_AUDITOR_PASSWORD=Demo@2024!

# =======================================================
# PRODUCTION: PostgreSQL (not required for demo mode)
# =======================================================
# DATABASE_URL=postgresql://clm_app:changeme@localhost:5432/clm
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=clm
# DB_USER=clm_app
# DB_PASSWORD=changeme
# DB_SSL=true

# =======================================================
# PRODUCTION: Redis (not required for demo mode)
# =======================================================
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# =======================================================
# PRODUCTION: Auth (Keycloak - not required for demo mode)
# =======================================================
# KEYCLOAK_URL=https://auth.enterprise.internal
# KEYCLOAK_REALM=clm
# KEYCLOAK_CLIENT_ID=clm-admin-portal
# KEYCLOAK_CLIENT_SECRET=changeme
# JWT_SECRET=changeme-use-random-256-bit-secret

# =======================================================
# PRODUCTION: AWS (not required for demo mode)
# =======================================================
# AWS_REGION=ap-south-1
# AWS_ACCOUNT_ID=279078306945
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ROLE_ARN=

# =======================================================
# PRODUCTION: AI Services (not required for demo mode)
# =======================================================
# AI_SERVICE_URL=https://ai.enterprise.internal
# AI_API_KEY=

# =======================================================
# NODE
# =======================================================
NODE_ENV=development
LOG_LEVEL=info
